# Public site URL (used for canonical URLs, OG metadata and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable/anon key (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
